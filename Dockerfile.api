# Construction séparée : Poetry n'est pas nécessaire dans l'image d'exécution.
FROM python:3.11-slim AS builder
ENV POETRY_NO_INTERACTION=1 POETRY_VIRTUALENVS_IN_PROJECT=true
RUN pip install --no-cache-dir poetry==2.1.3
WORKDIR /app
COPY pyproject.toml poetry.lock README.md ./
RUN poetry install --only main --no-root
COPY src ./src
COPY configs ./configs
RUN poetry install --only-root

FROM python:3.11-slim AS runtime
# OpenMP est nécessaire aux bibliothèques de boosting natives.
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 bnpl
WORKDIR /app
COPY --from=builder /app /app
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    BNPL_API_HOST=0.0.0.0 BNPL_API_ENVIRONMENT=production \
    OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 \
    MPLCONFIGDIR=/tmp/matplotlib
USER bnpl
EXPOSE 8000
# Readiness vérifie que le modèle a été chargé et préchauffé avec succès.
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=2)"
ENTRYPOINT ["bnpl-api"]
