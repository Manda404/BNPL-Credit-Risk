# Copy to .env and adjust. No secrets belong in this file or in .env.example.

# Root-relative paths (leave as-is unless you relocate data)
BNPL_DATA_RAW_PATH=data/raw/BNPL_CreditRisk_Dataset.csv
BNPL_ARTIFACTS_DIR=artifacts
BNPL_LOGS_DIR=logs

# Logging
BNPL_LOG_LEVEL=INFO

# MLflow (optional — leave BNPL_MLFLOW_ENABLED=false to run fully offline)
BNPL_MLFLOW_ENABLED=false
BNPL_MLFLOW_TRACKING_URI=file:./mlruns
BNPL_MLFLOW_EXPERIMENT_NAME=bnpl-credit-risk

# Random seed used across splitting / training for reproducibility
BNPL_RANDOM_SEED=42
