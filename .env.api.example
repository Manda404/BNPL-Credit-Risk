# Copier les variables utiles dans .env (sans écraser un éventuel fichier existant).
# Générer la clé : poetry run python -c 'import secrets; print(secrets.token_urlsafe(32))'
BNPL_API_API_KEY=
BNPL_API_ENVIRONMENT=development
BNPL_API_HOST=127.0.0.1
BNPL_API_PORT=8000
# Facultatif en développement : utilise configs/inference.yaml (latest).
# En production : obligatoire, version exacte approuvée dans artifacts/models/.
# BNPL_API_MODEL_VERSION=2026-08-28_131115
BNPL_API_MAX_BODY_BYTES=16384
BNPL_API_MAX_CONCURRENT_PREDICTIONS=1
BNPL_API_LOG_LEVEL=INFO
